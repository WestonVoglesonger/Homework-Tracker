# Database
POSTGRES_PRISMA_URL=postgresql://postgres:postgres@db:5432/homework_dev
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@db:5432/homework_dev

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Canvas Integration (optional)
CANVAS_BASE_URL="https://your-institution.instructure.com"
CANVAS_CLIENT_ID="your-canvas-client-id"
CANVAS_CLIENT_SECRET="your-canvas-client-secret"
CANVAS_REDIRECT_URL="http://localhost:3000/api/canvas/oauth/callback"

# Email (optional)
EMAIL_SERVER="smtp://username:password@smtp.example.com:587"
EMAIL_FROM="noreply@example.com"

# Cron Secret (optional)
CRON_SECRET="your-cron-secret-here"
