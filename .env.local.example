# Database
POSTGRES_PRISMA_URL=postgresql://postgres:postgres@db:5432/homework_dev
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@db:5432/homework_dev

# Canvas Integration (optional)
CANVAS_BASE_URL="https://yourcanvas.instructure.com"
CANVAS_REDIRECT_URL="http://localhost:3000/api/canvas/oauth/callback"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="REPLACE_ME_BEFORE_PROD"

# Email
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32B
EMAIL_FROM="Your Name <no-reply@example.com>"
EMAIL_SERVER="smtp://apikey:YOUR_SENDGRID_API_KEY@smtp.sendgrid.net:587"

# Optional: Rate limit (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin System
ADMIN_PASSWORD_HASH="$2a$12$REPLACE_WITH_BCRYPT_HASH"
